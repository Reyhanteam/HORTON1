APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Router
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_POLLING_INTERVAL=1500
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Telegram Router queue integration
TELEGRAM_QUEUE_UPDATES=false
TELEGRAM_QUEUE_CONNECTION=
TELEGRAM_QUEUE_NAME=default
TELEGRAM_QUEUE_TRIES=3
TELEGRAM_QUEUE_BACKOFF=10,30,60
TELEGRAM_QUEUE_TIMEOUT=120
TELEGRAM_QUEUE_DEDUPLICATE_UPDATES=true
TELEGRAM_QUEUE_DEDUPLICATION_TTL=86400
TELEGRAM_QUEUE_CACHE_STORE=

# Telegram Router conversations
TELEGRAM_CONVERSATION_TTL=3600
TELEGRAM_CONVERSATION_CACHE_STORE=

# Telegram Router incoming rate limits
TELEGRAM_RATE_LIMIT_ENABLED=false
TELEGRAM_RATE_LIMIT_PREFIX=telegram_bot_router.rate_limit
TELEGRAM_RATE_LIMIT_USER_MAX=60
TELEGRAM_RATE_LIMIT_USER_DECAY=60
TELEGRAM_RATE_LIMIT_CHAT_MAX=120
TELEGRAM_RATE_LIMIT_CHAT_DECAY=60
TELEGRAM_RATE_LIMIT_COMMAND_MAX=30
TELEGRAM_RATE_LIMIT_COMMAND_DECAY=60

# Telegram Router outgoing API limits / Telegram retry_after handling
TELEGRAM_OUTGOING_RATE_LIMIT_ENABLED=false
TELEGRAM_OUTGOING_RATE_LIMIT_PREFIX=telegram_bot_router.outgoing_rate_limit
TELEGRAM_OUTGOING_RATE_LIMIT_MAX=30
TELEGRAM_OUTGOING_RATE_LIMIT_DECAY=1
TELEGRAM_OUTGOING_RATE_LIMIT_QUEUE_AWARE=true
TELEGRAM_RETRY_AFTER_ENABLED=true
TELEGRAM_RETRY_AFTER_MAX_RETRIES=3
TELEGRAM_RETRY_AFTER_BACKOFF=1,2,4

VITE_APP_NAME="${APP_NAME}"
